# ---------------------------------------------------------------------
# EXERCISE 3.1: მატრიცების შექმნა, მოდიფიკაცია და ინდექსაცია
# ---------------------------------------------------------------------

# a. 4x2 მატრიცის შექმნა, რომელიც ივსება რიგების მიხედვით (row-wise)
matrix_a <- matrix(c(4.3, 3.1, 8.2, 8.2, 3.2, 0.9, 1.6, 6.5), 
                   nrow = 4, ncol = 2, byrow = TRUE)
print("--- 3.1 (a) მატრიცა ---")
print(matrix_a)

# b. განზომილებების შემოწმება ნებისმიერი ერთი რიგის ამოჭრის შემდეგ (უნდა იყოს 3x2)
matrix_b <- matrix_a[-1, ]
print("--- 3.1 (b) განზომილება რიგის ამოჭრის შემდეგ ---")
print(dim(matrix_b))

# c. მეორე სვეტის გადაწერა (Overwrite) იგივე სვეტით, ზრდადობით დალაგებული სახით
matrix_a[, 2] <- sort(matrix_a[, 2])
print("--- 3.1 (c) მეორე სვეტის დალაგების შემდეგ ---")
print(matrix_a)

# d. მე-4 რიგისა და 1-ლი სვეტის წაშლა, მატრიცის ტიპის შენარჩუნებით (single-column matrix)
matrix_d <- matrix(matrix_a[-4, -1], ncol = 1)
print("--- 3.1 (d) ერთსვეტიანი მატრიცა ---")
print(matrix_d)

# e. (c) მატრიცის ბოლო ოთხი ელემენტის შენახვა ახალ 2x2 მატრიცად
matrix_e <- matrix(matrix_a[3:4, 1:2], nrow = 2, ncol = 2)
print("--- 3.1 (e) ახალი 2x2 მატრიცა ---")
print(matrix_e)

# f. (c) მატრიცის კონკრეტული პოზიციების გადაწერა (4,2), (1,2), (4,1), (1,1)
diag_vals <- diag(matrix_e)
matrix_a[4, 2] <- diag_vals[1]
matrix_a[1, 2] <- diag_vals[2]
matrix_a[4, 1] <- diag_vals[1]
matrix_a[1, 1] <- diag_vals[2]
print("--- 3.1 (f) ელემენტების გადაწერის შემდეგ ---")
print(matrix_a)


# ---------------------------------------------------------------------
# EXERCISE 3.2: მატრიცული ალგებრა და ოპერაციები
# ---------------------------------------------------------------------

# a. სკალარული გამრავლება და მატრიცული გამოკლება
scalar_val <- 2 / 7
mat1 <- matrix(c(1, 2, 2, 4, 7, 6), nrow = 3, ncol = 2, byrow = TRUE)
mat2 <- matrix(c(10, 20, 30, 40, 50, 60), nrow = 3, ncol = 2, byrow = TRUE)

result_a <- scalar_val * mat1 - mat2
print("--- 3.2 (a) შედეგი ---")
print(result_a)


# b. ვექტორების/მატრიცების განსაზღვრა და გამრავლების შესაძლებლობები
A <- matrix(c(1, 2, 7), nrow = 3, ncol = 1) # 3x1 მატრიცა
B <- matrix(c(3, 4, 8), nrow = 3, ncol = 1) # 3x1 მატრიცა

# i. A * B - არ არის შესაძლებელი მატრიცული განზომილებების გამო.

# ii. t(A) %*% B
res_ii <- t(A) %*% B
print("--- 3.2 (b.ii) შედეგი ---")
print(res_ii)

# iii. t(B) %*% (A %*% t(A))
res_iii <- t(B) %*% (A %*% t(A))
print("--- 3.2 (b.iii) შედეგი ---")
print(res_iii)

# iv. (A %*% t(A)) %*% t(B) -> შეუძლებელია განზომილებათა შეუსაბამობის გამო (3x3 გამრავლებული 1x3-ზე)
# res_iv <- (A %*% t(A)) %*% t(B) 

# v. მატრიცული ინვერსია: [(B %*% t(B)) + (A %*% t(A)) - 100 * I3]^(-1)
I3 <- diag(3)
term_v <- (B %*% t(B)) + (A %*% t(A)) - 100 * I3
res_v <- solve(term_v)
print("--- 3.2 (b.v) შედეგი ---")
print(res_v)


# c. მატრიცა A-ს ინვერსიის დადასტურება
A_c <- matrix(c(2, 0, 0, 0, 
                0, 3, 0, 0, 
                0, 0, 5, 0, 
                0, 0, 0, -1), nrow = 4, ncol = 4, byrow = TRUE)
I4 <- diag(4)

res_c <- solve(A_c) %*% A_c - I4
print("--- 3.2 (c) შედეგი (ნულოვანი მატრიცა) ---")
print(res_c)
